source("../../code/mpra_tools/mpra_tools.R")
d <- fread("../../data/formatted/Library1_plus_Controls_forPaper_FullRun_31Jul2025/compiled_31Jul2025.txt")
d_avg <- filter(d,Fraction=="DNA")
d_avg <- d_avg %>% group_by(Element) %>% summarize(CPM=mean(CPM))
d_exp <- filter(d,Fraction!="DNA")
d_exp <- as.data.table(left_join(d_exp,d_avg,"Element"))
d_exp <- as.data.table(d_exp[,Expression := log2(CPM.x/CPM.y)])
d_exp <- tidyr::separate(d_exp,Element,c("Element","Library","Allele"),sep="_")
d_exp <- tidyr::unite(d_exp,"Element",c("Element","Library"))
d_exp <- as.data.table(left_join(
filter(d_exp,Fraction=="Post"),
filter(d_exp,Fraction=="Pre"),
c("Element","BiolRep","Allele")
))
d_exp[,Stability := Expression.x-Expression.y]
res <- mpratools.lm(filter(d_exp,is.finite(Stability)),Stability~Allele)
View(res)
ggplot(filter(d_exp,Element=="PRE_ctl"))+geom_boxplot(aes(x=Allele,y=Stability,fill=Allele))
ggplot(filter(d_exp,Element=="SRE_ctl"))+geom_boxplot(aes(x=Allele,y=Stability,fill=Allele))
ggplot(filter(d_exp,Element=="WPRE_ctl"))+geom_boxplot(aes(x=Allele,y=Stability,fill=Allele))
#That's odd
ggplot(filter(d_exp,Element=="WPRE-alpha_dnvctl"))+geom_boxplot(aes(x=Allele,y=Stability,fill=Allele))
ggplot(filter(d_exp,Element=="PREx4_dnvctl"))+geom_boxplot(aes(x=Allele,y=Stability,fill=Allele))
ggplot(filter(d_exp,Element=="SREx4_dnvctl"))+geom_boxplot(aes(x=Allele,y=Stability,fill=Allele))
library(ggsignif)
d_exp_ctls <- filter(d_exp, Element %in% c("PRE_ctl", "SRE_ctl"), is.finite(Stability))
d_exp_ctls$Allele <- factor(d_exp_ctls$Allele,levels=c("ref","alt"),labels = c("Control","Mutated"))
d_exp_ctls$Element <- factor(d_exp_ctls$Element,levels=c("PRE_ctl","SRE_ctl"),
labels = c("Pumilio Response Element","Smaug Response Element"))
ggplot(d_exp_ctls,aes(x = Allele, y = Stability, fill = Allele)) +
geom_boxplot() +
geom_point(shape = 21, position = position_jitter(width = 0.1)) +
geom_signif(comparisons = list(c("Control", "Mutated"))) +
facet_wrap(~Element)+
theme(legend.position = "none")
d_ctl_long <- as.data.table(pivot_longer(d_exp_ctls,c(8,13),names_to = "Pool",values_to = "Expression") %>% select(c(1,2,4,13,14)))
d_ctl_long$Pool <- str_replace_all(d_ctl_long$Pool,"Expression.x","Post")
d_ctl_long$Pool <- str_replace_all(d_ctl_long$Pool,"Expression.y","Pre")
d_ctl_long[, Pool := factor(Pool,levels = c("Pre","Post"))]
ggplot(d_ctl_long,aes(x=Allele,y=Expression,fill=Pool,group=interaction(Allele,Pool)))+
geom_boxplot(color="black",outliers = TRUE,position = position_dodge(width = 1),linewidth=0.1)+
geom_point(shape=21,color="black",position = position_dodge(width = 1))+
stat_smooth(method="lm",aes(group=Allele),show.legend = TRUE,linewidth=0.25)+
scale_fill_manual(values=c("#67e5bf","#136d52"))+
scale_color_manual(values=c("#67e5bf","#136d52"))+
facet_wrap(~Element)
ggplot(d_exp_ctls,aes(x = Allele, y = Stability, fill = Allele)) +
geom_boxplot() +
geom_point(shape = 21, position = position_jitter(width = 0.1)) +
geom_signif(comparisons = list(c("Control", "Mutated"))) +
facet_wrap(~Element)+
theme(legend.position = "none")
library(fplot)
export_graph_start("Control_Element_Boxplot.pdf",sideways = TRUE)
ggplot(d_exp_ctls,aes(x = Allele, y = Stability, fill = Allele)) +
geom_boxplot() +
geom_point(shape = 21, position = position_jitter(width = 0.1)) +
geom_signif(comparisons = list(c("Control", "Mutated"))) +
facet_wrap(~Element)+
theme(legend.position = "none")
export_graph_end()
dir.create("../../figure_making/Figures")
dir.create("../../figure_making/Figures/Figure_2")
export_graph_start("../../figure_making/Figures/Figure_2/Control_Element_Boxplot.pdf",sideways = TRUE)
ggplot(d_exp_ctls,aes(x = Allele, y = Stability, fill = Allele)) +
geom_boxplot() +
geom_point(shape = 21, position = position_jitter(width = 0.1)) +
geom_signif(comparisons = list(c("Control", "Mutated"))) +
facet_wrap(~Element)+
theme(legend.position = "none")
export_graph_end()
