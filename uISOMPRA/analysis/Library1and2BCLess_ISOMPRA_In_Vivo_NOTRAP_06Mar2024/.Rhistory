#Post-Splicing Cre-ON
nulls <- as.data.table(filter(d_expr,
Allele=="shuf",
Cre_Status=="ON",
Splicing_Pool=="Post",
is.finite(Expression)) %>%
group_by(Element) %>%
summarize(Expression=mean(Expression)))
post_ON_shuf <- lapply(Vglut1.ON.Post.to.test$Element, function(element) {
welch_shuftest(data_table = filter(d_expr,
Cre_Status=="ON",
Splicing_Pool=="Post",
is.finite(Expression)),
element = element,
allele = "ref",
null_values=nulls$Expression)
})
