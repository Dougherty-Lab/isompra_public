full_join(
fread("./Stability_Vglut1_CreOFF_AllelevsSplicevsSex_LM"),
fread("../../code/mpra_tools/fullannotationtable.txt"))
,"Stability_Vglut1_CreOFF_AllelevsSplicevsSex_LM_Annotated", sep = "\t")
