!(Animal_Hemisphere=="3R" & Splicing_Pool=="Post"),
!(Animal_Hemisphere=="2R" & Splicing_Pool=="Pre"),
Animal_Hemisphere!="2R",
!(Animal_Hemisphere=="4R" & Splicing_Pool=="Post"),
!(Animal_Hemisphere=="5R" & Splicing_Pool=="Pre")
),
factor1 = "Allele",
factor2 = "Splicing_Pool",
factor3 = "Cre_Status",
levels_factor3 = c("OFF","ON")
)
fwrite(res, "Vglut1_AllelevsSplicevsCreStatus_LM.tsv", sep="\t")
